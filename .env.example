# Copy to .env and fill in.
# Copy-Item .env.example .env      (PowerShell)

# --- Model ---------------------------------------------------------------
# Ungated mirror of Meta's weights (public: no licence click, no token)
LLAMA_MODEL_ID=unsloth/Llama-3.2-1B-Instruct
# Official gated repo instead: accept the licence on huggingface.co, then
# set HF_TOKEN below and uncomment this line.
# LLAMA_MODEL_ID=meta-llama/Llama-3.2-1B-Instruct

HF_TOKEN=

# --- Pipeline knobs ------------------------------------------------------
# Calibration samples for AWQ (128 is the AWQ paper default)
AWQ_CALIB_SAMPLES=128
# Fraction of the MLP intermediate dimension to KEEP when pruning
PRUNE_KEEP_RATIO=0.75
# Evaluation samples per task
EVAL_LIMIT=200
# Max sequence length used by the evaluator
EVAL_MAX_LEN=1024
# Optional LoRA "healing" steps after pruning (0 = off, ~15 min on a 3050 for 300)
HEAL_STEPS=0

# --- Extended benchmarks (GSM8K / MS MARCO / BoolQ) ----------------------
# Samples per task and max generated tokens for the generative tasks
EXTENDED_LIMIT=100
EXTENDED_MAX_NEW_TOKENS=256
